# Promptcha API — .env namunasi. Nusxa: cp .env.example .env

# Ilova (prod: APP_ENV=production — shunda zaif sirlar bilan ishga tushmaydi)
APP_ENV=development
APP_SECRET=change-me-long-random-string
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptcha

# AI provayderlar zanjiri (tartib muhim; kaliti yoʻqlar tashlab ketiladi).
# gemini | groq | mistral | openrouter | custom | anthropic
AI_PROVIDERS=groq,gemini,mistral,openrouter,sambanova,huggingface,hyperbolic,cerebras,cohere
# Yengil bosqichlar (tahlil, reja) uchun alohida tartib — tezlik uchun Groq birinchi; bo'sh bo'lsa AI_PROVIDERS
AI_PROVIDERS_LIGHT=groq,anthropic,gemini
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.4

# Gemini — https://aistudio.google.com/apikey (bepul: har model kuniga ~20 soʻrov)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Groq — https://console.groq.com/keys (bepul: 30/daqiqa, 6k token/daqiqa, 1000–14400/kun)
# OpenAI (pullik; kredit kerak)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_LIGHT_MODEL=gpt-5-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Yengil bosqichlar (tahlil, reja) uchun tezroq model — Groq'da har model alohida token limitiga ega
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Mistral — https://console.mistral.ai (Experiment tarif: bepul, maʼlumot oʻrgatishga rozilik kerak)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FALLBACK_MODELS=

# OpenRouter — https://openrouter.ai/keys (bepul: kuniga 50 soʻrov, ":free" modellar)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=

# Boshqa OpenAI-mos tekin tariflar (github.com/OuterSpacee/free-ai-apis). Kalit qoʻyilsa zanjirga qoʻshiladi.
# Model nomlari taxminiy — kalit kelganda /v1/models bilan tekshiriladi.
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct
HYPERBOLIC_API_KEY=
HYPERBOLIC_MODEL=meta-llama/Llama-3.3-70B-Instruct
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Istalgan OpenAI-mos server (masalan lokal Ollama: http://localhost:11434/v1)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=no-key
CUSTOM_MODEL=
CUSTOM_FALLBACK_MODELS=

# Anthropic (AI_PROVIDERS ichida "anthropic" boʻlsa)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# «Yaxshilash» uchun kuchliroq model (sekinroq)
ANTHROPIC_QUALITY_MODEL=claude-sonnet-5

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# JWT (httpOnly cookie)
JWT_SECRET=change-me-another-long-random-string
JWT_EXPIRE_DAYS=30
# Admin — Google email ro'yxati (vergul bilan). Alohida parol yo'q
ADMIN_EMAILS=
# Faqat dev: /api/auth/dev-login?email=... (prod'da true bo'lsa server ishga tushmaydi)
AUTH_DEV_LOGIN=false

# Limitlar (serverda, usage_log boʻyicha)
FREE_DAILY_GENERATIONS=5
GUEST_TOTAL_GENERATIONS=3
GUEST_DAILY_IP_GENERATIONS=15

# Xavfsizlik
# Nginx har /api/ soʻrovga X-Internal-Key qoʻshadi; qiymat deploy/nginx.conf bilan bir xil (openssl rand -hex 32)
INTERNAL_API_KEY=
# Nginx orqasida true: haqiqiy IP X-Forwarded-For dan olinadi
TRUST_PROXY=false
